        simulator = AerSimulator()
        result = simulator.run(qc).result()
        corrected_state = result.get_statevector()
        
        return corrected_state
    
    def add_stabilizer_measurements(self, quantum_circuit: QuantumCircuit) -> QuantumCircuit:
        """Add stabilizer measurements to circuit"""
        
        n_qubits = quantum_circuit.num_qubits
        
        # Add ancilla qubits for syndrome measurement
        num_stabilizers = len(self.stabilizers.get('z_stabilizers', [])) + \
                         len(self.stabilizers.get('x_stabilizers', []))
        
        # Add syndrome qubits
        for i in range(num_stabilizers):
            quantum_circuit.add_register(QuantumRegister(1, f'syndrome_{i}'))
        
        # Add stabilizer measurements
        syndrome_idx = 0
        
        # Z stabilizers
        for stabilizer in self.stabilizers.get('z_stabilizers', []):
            ancilla = n_qubits + syndrome_idx
            quantum_circuit.h(ancilla)
            
            for qubit in stabilizer:
                quantum_circuit.cx(ancilla, qubit)
            
            quantum_circuit.h(ancilla)
            quantum_circuit.measure(ancilla, ancilla)
            syndrome_idx += 1
        
        # X stabilizers
        for stabilizer in self.stabilizers.get('x_stabilizers', []):
            ancilla = n_qubits + syndrome_idx
            quantum_circuit.h(ancilla)
            
            for qubit in stabilizer:
                quantum_circuit.cz(ancilla, qubit)
            
            quantum_circuit.h(ancilla)
            quantum_circuit.measure(ancilla, ancilla)
