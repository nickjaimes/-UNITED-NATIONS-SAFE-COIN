        for validator_id in self.active_validators:
            validator = self.validators[validator_id]
            
            # Calculate weight based on multiple factors
            weight = await self.calculate_validator_weight(validator)
            weights[validator_id] = weight
            total_weight += weight
        
        # Normalize to probabilities
        probabilities = {}
        for validator_id, weight in weights.items():
            probabilities[validator_id] = weight / total_weight
        
