    async def vote_on_proposal(self, proposal_id: str, voter: str, 
                             vote: str, voting_power: Optional[float] = None) -> bool:
        """Vote on a proposal"""
        
        if proposal_id not in self.proposals:
            return False
        
        if voter not in self.members:
            return False
        
        proposal = self.proposals[proposal_id]
        
        # Check if voting is active
        if proposal.status != "voting":
            return False
        
        if time.time() < proposal.voting_start:
            return False
        
        if proposal.voting_end and time.time() > proposal.voting_end:
            proposal.status = "closed"
            return False
        
        # Get voter's voting power
        if voting_power is None:
            voting_power = self.members[voter].voting_power
        
        # Record vote
        vote_value = voting_power
        
        if vote.lower() == "for":
            proposal.votes_for += vote_value
        elif vote.lower() == "against":
            proposal.votes_against += vote_value
        elif vote.lower() == "abstain":
            proposal.votes_abstain += vote_value
        else:
            return False
        
        # Add vote to blockchain
        await self.record_vote(proposal_id, voter, vote, vote_value)
        
        # Check if voting is complete
        await self.check_voting_completion(proposal)
        
        return True
    
    async def check_voting_completion(self, proposal: DAOProposal):
        """Check if voting is complete and determine result"""
        
        if not proposal.voting_end or time.time() < proposal.voting_end:
            return
        
        total_votes = proposal.votes_for + proposal.votes_against + proposal.votes_abstain
        total_possible = sum(m.voting_power for m in self.members.values())
        
        # Check quorum
        participation_rate = total_votes / total_possible if total_possible > 0 else 0
        
        if participation_rate < proposal.required_quorum:
            proposal.status = "failed_quorum"
            return
        
        # Use appropriate voting engine
        voting_engine = self.voting_engines[proposal.vote_type]
        
        result = voting_engine.calculate_result(
            proposal.votes_for,
            proposal.votes_against,
            proposal.votes_abstain,
            proposal.required_majority
        )
        
        proposal.status = "passed" if result['passed'] else "rejected"
        
        if result['passed']:
            # Execute proposal
            execution_result = await self.execute_proposal(proposal)
            proposal.execution_hash = execution_result.get('tx_hash', '')
            
            # Update member contributions based on voting
            await self.update_member_contributions(proposal, result)
    
