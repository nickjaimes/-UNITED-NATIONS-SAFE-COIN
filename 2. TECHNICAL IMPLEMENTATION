    def calculate_voting_power(self, population: int, gdp: float, 
                             contribution: float) -> float:
        """Calculate voting power based on multiple factors"""
        
        # Normalize factors
        max_population = 1400000000  # China's population
        max_gdp = 23000000  # US GDP in millions
        
        pop_factor = population / max_population
        gdp_factor = gdp / max_gdp
        contribution_factor = contribution
        
        # Weighted combination (population 40%, GDP 30%, contribution 30%)
        voting_power = (
            pop_factor * 0.4 +
            gdp_factor * 0.3 +
            contribution_factor * 0.3
        )
        
        return voting_power
    
    async def create_proposal(self, author: str, title: str, description: str,
                            proposal_type: ProposalType, vote_type: VoteType = VoteType.QUALIFIED_MAJORITY) -> str:
